{
  "name": "nourishnet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "fast-check": "3.23.2",
    "vitest": "3.2.4"
  }
}
